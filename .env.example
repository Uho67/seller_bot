# Read by `docker compose` when parsing docker-compose.yml.
# Must live next to docker-compose.yml — backend/.env is NOT read for this
# (env_file only injects vars into the running container, it does not
# substitute ${...} in the compose file itself).
#
# Copy to .env on each host and set per-instance values:
#   cp .env.example .env

# Container name. Must be unique on the host — other bots share this server.
CONTAINER_NAME=flow_bot

# Host port -> container port. Both must match what Nginx proxies to.
HOST_PORT=3007
PORT=3007

# URL prefix Nginx rewrites to / before proxying. Also the Vite base
# and React Router basename for the admin panel.
VITE_BASE_PATH=/flow
